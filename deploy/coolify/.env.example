# Copy these into Coolify -> your application -> Environment Variables.
# Mark every secret as "Is Build Variable? = No" -- they are runtime only.

# --- Required -----------------------------------------------------------------
# HTTP basic auth for the whole server. Generate with: openssl rand -base64 24
# If this is empty the server starts UNAUTHENTICATED and anyone with the URL can
# run arbitrary shell commands in the container.
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# --- Model provider: a public provider ----------------------------------------
# The accepted names come from models.dev's `env` field for each provider.
# Skip these entirely if you use your own gateway (see below).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Model provider: your own OpenAI-compatible gateway -----------------------
# A whole opencode.json as a single-line string. @ai-sdk/openai-compatible is
# compiled into the binary, so nothing is fetched from npm at runtime.
# Keep the key in its own variable and reference it with {env:...} so the secret
# never sits inside the config value.
# OPENCODE_CONFIG_CONTENT={"$schema":"https://opencode.ai/config.json","provider":{"mycorp":{"npm":"@ai-sdk/openai-compatible","name":"MyCorp Gateway","options":{"baseURL":"https://llm.internal.example.com/v1","apiKey":"{env:MYCORP_API_KEY}"},"models":{"mycorp-large":{"name":"MyCorp Large","tool_call":true,"limit":{"context":128000,"output":8192}}}}},"model":"mycorp/mycorp-large"}
# MYCORP_API_KEY=

# --- Git identity for commits the agent makes ---------------------------------
GIT_AUTHOR_NAME=opencode
GIT_AUTHOR_EMAIL=opencode@example.com

# --- Optional -----------------------------------------------------------------
# Extra browser origin to allow. Only needed if you reach the server from a
# different domain than the one it is served on -- same-origin already works.
# OPENCODE_CORS_ORIGIN=https://opencode.example.com

# Listen address inside the container. Leave these alone unless you know why.
# OPENCODE_HOSTNAME=0.0.0.0
# OPENCODE_PORT=4096
